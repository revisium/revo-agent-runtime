{
  "schemaVersion": "revo-agent-runtime-layers/v1",
  "sourceRoot": "src",
  "rootModule": "src/index.ts",
  "layers": [
    {
      "name": "contracts-session-envelope",
      "pattern": "^src/contracts/session/continuation/envelope\\.ts$",
      "dependencies": ["contracts", "contracts-session"]
    },
    {
      "name": "contracts-session",
      "pattern": "^src/contracts/session(?:\\.ts|/(?!continuation/envelope\\.ts$).+)$",
      "dependencies": ["contracts"]
    },
    {
      "name": "contracts-manager-surface",
      "pattern": "^src/contracts/manager(?:\\.ts|/(?:api|options)\\.ts)$",
      "dependencies": ["contracts", "contracts-session"]
    },
    {
      "name": "contracts",
      "pattern": "^src/contracts/(?!(?:session(?:\\.ts|/)|manager(?:\\.ts|/(?:api|options)\\.ts$))).+",
      "dependencies": ["process-contracts"]
    },
    {
      "name": "diagnostics",
      "pattern": "^src/diagnostics/",
      "dependencies": ["contracts"]
    },
    {
      "name": "configuration",
      "pattern": "^src/configuration/",
      "dependencies": ["contracts", "definition"]
    },
    {
      "name": "definition",
      "pattern": "^src/definition/",
      "dependencies": ["contracts"]
    },
    {
      "name": "discovery",
      "pattern": "^src/discovery/",
      "dependencies": ["contracts", "definition", "platform", "providers"]
    },
    {
      "name": "providers",
      "pattern": "^src/providers/",
      "dependencies": [
        "contracts",
        "configuration",
        "definition",
        "discovery",
        "execution",
        "protocol"
      ]
    },
    {
      "name": "application-session-boundary",
      "pattern": "^src/application/session/boundary/",
      "dependencies": [
        "contracts",
        "contracts-session",
        "contracts-session-envelope",
        "definition",
        "execution",
        "execution-security-digest-port"
      ]
    },
    {
      "name": "application-admission",
      "pattern": "^src/application/admission/",
      "dependencies": ["contracts", "definition", "execution"]
    },
    {
      "name": "application-session-admission",
      "pattern": "^src/application/session/admission/",
      "dependencies": [
        "application-admission",
        "contracts",
        "definition",
        "execution",
        "execution-session-output-port",
        "session-opening-preparation-port"
      ]
    },
    {
      "name": "application-session-policy",
      "pattern": "^src/application/session/policy/",
      "dependencies": ["contracts", "contracts-session", "definition"]
    },
    {
      "name": "application-session-management",
      "pattern": "^src/application/session/management/",
      "dependencies": [
        "application-session-boundary",
        "application-session-handles",
        "application-session-policy",
        "contracts",
        "contracts-session",
        "definition",
        "process-contracts",
        "session-runtime-dispatch"
      ]
    },
    {
      "name": "application-session-handles",
      "pattern": "^src/application/session/handles/",
      "dependencies": [
        "contracts",
        "contracts-session",
        "session-kernel-public-command",
        "session-runtime-dispatch"
      ]
    },
    {
      "name": "application",
      "pattern": "^src/application/(?!session/|admission/).+",
      "dependencies": [
        "application-admission",
        "application-session-management",
        "application-session-policy",
        "contracts",
        "contracts-manager-surface",
        "contracts-session",
        "definition",
        "execution",
        "process-contracts"
      ]
    },
    {
      "name": "composition-session",
      "pattern": "^src/composition/session/",
      "dependencies": [
        "application-session-admission",
        "application-session-management",
        "execution",
        "process-contracts",
        "execution-security-digest-port",
        "execution-session-output-port",
        "protocol-session",
        "session-interpreter",
        "session-kernel",
        "session-runtime"
      ]
    },
    {
      "name": "session-opening-preparation-port",
      "pattern": "^src/execution/session/port/",
      "dependencies": [
        "contracts",
        "contracts-session",
        "process-contracts",
        "execution-session-output-port",
        "session-kernel"
      ]
    },
    {
      "name": "session-kernel-effects",
      "pattern": "^src/execution/session/kernel/effect/",
      "dependencies": ["contracts", "contracts-session", "session-kernel"]
    },
    {
      "name": "session-kernel-public-command",
      "pattern": "^src/execution/session/kernel/command/public\\.ts$",
      "dependencies": ["contracts", "contracts-session", "session-kernel"]
    },
    {
      "name": "session-kernel",
      "pattern": "^src/execution/session/kernel/(?!effect/|command/public\\.ts$).+",
      "dependencies": [
        "contracts",
        "contracts-session",
        "session-kernel-effects",
        "session-kernel-public-command"
      ]
    },
    {
      "name": "session-runtime-resources",
      "pattern": "^src/execution/session/runtime/resources/",
      "dependencies": []
    },
    {
      "name": "session-runtime-dispatch",
      "pattern": "^src/execution/session/runtime/actor/port\\.ts$",
      "dependencies": [
        "contracts",
        "contracts-session",
        "session-kernel-effects",
        "session-kernel-public-command"
      ]
    },
    {
      "name": "session-runtime-identity-port",
      "pattern": "^src/execution/session/runtime/primitives/identity\\.ts$",
      "dependencies": ["contracts", "contracts-session"]
    },
    {
      "name": "session-runtime-outcome-port",
      "pattern": "^src/execution/session/runtime/effects/outcomes\\.ts$",
      "dependencies": ["contracts-session", "session-kernel-effects"]
    },
    {
      "name": "session-runtime",
      "pattern": "^src/execution/session/runtime/(?!(?:actor/port|primitives/identity|effects/outcomes)\\.ts$|resources/).+",
      "dependencies": [
        "contracts-session",
        "session-kernel",
        "session-kernel-effects",
        "session-kernel-public-command",
        "session-runtime-dispatch",
        "session-runtime-identity-port",
        "session-runtime-outcome-port",
        "session-runtime-resources"
      ]
    },
    {
      "name": "session-interpreter",
      "pattern": "^src/execution/session/interpreter/",
      "dependencies": [
        "contracts",
        "contracts-session",
        "contracts-session-envelope",
        "process-contracts",
        "execution-security-redaction",
        "execution-security-digest-port",
        "execution-session-output-port",
        "protocol-session",
        "session-kernel-effects",
        "session-opening-preparation-port",
        "session-runtime-identity-port",
        "session-runtime-outcome-port",
        "session-runtime-resources"
      ]
    },
    {
      "name": "process-contracts",
      "pattern": "^src/process/(?!node(?:\\.ts$|/))",
      "dependencies": []
    },
    {
      "name": "execution-security-redaction",
      "pattern": "^src/execution/security/redaction/",
      "dependencies": []
    },
    {
      "name": "execution-security-digest-port",
      "pattern": "^src/execution/security/digest/port\\.ts$",
      "dependencies": ["contracts"]
    },
    {
      "name": "execution-session-output-port",
      "pattern": "^src/execution/output/session/publication\\.ts$",
      "dependencies": ["contracts", "contracts-session"]
    },
    {
      "name": "execution",
      "pattern": "^src/execution/(?!(?:session/|security/(?:digest/port\\.ts$|redaction/)|output/session/publication\\.ts$)).+",
      "dependencies": [
        "configuration",
        "diagnostics",
        "contracts",
        "definition",
        "process-contracts",
        "execution-security-redaction",
        "protocol"
      ]
    },
    {
      "name": "protocol-session",
      "pattern": "^src/protocol/session/",
      "dependencies": ["configuration", "contracts", "diagnostics"]
    },
    {
      "name": "protocol-acp-session",
      "pattern": "^src/protocol/acp/session/",
      "dependencies": ["configuration", "contracts", "protocol", "protocol-session"]
    },
    {
      "name": "protocol",
      "pattern": "^src/protocol/(?!session/|acp/session/).+",
      "dependencies": ["configuration", "contracts", "diagnostics"]
    },
    {
      "name": "platform-session-output",
      "pattern": "^src/platform/node/output/session/",
      "dependencies": [
        "contracts",
        "contracts-session",
        "execution",
        "execution-session-output-port",
        "platform"
      ]
    },
    {
      "name": "platform-session-primitives",
      "pattern": "^src/platform/node/session/primitives/",
      "dependencies": ["session-runtime-identity-port"]
    },
    {
      "name": "platform-security-digest",
      "pattern": "^src/platform/node/security/digest\\.ts$",
      "dependencies": ["execution-security-digest-port"]
    },
    {
      "name": "platform",
      "pattern": "^src/platform/(?!(?:node/output/session/|node/session/primitives/|node/security/digest\\.ts$)).+",
      "dependencies": ["discovery", "execution", "process-contracts", "process-node"]
    },
    {
      "name": "root",
      "pattern": "^src/index\\.ts$",
      "dependencies": [
        "application",
        "composition-session",
        "contracts",
        "contracts-manager-surface",
        "contracts-session",
        "discovery",
        "execution",
        "process-contracts",
        "execution-security-digest-port",
        "execution-session-output-port",
        "platform",
        "platform-security-digest",
        "platform-session-output",
        "platform-session-primitives",
        "protocol",
        "protocol-acp-session",
        "providers",
        "process-node"
      ]
    },
    {
      "name": "process-node",
      "pattern": "^src/process/node(?:\\.ts|/)",
      "dependencies": ["process-contracts"]
    }
  ]
}
