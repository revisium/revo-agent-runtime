{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import"],
  "rules": {
    "import/no-cycle": ["error", { "ignoreTypes": false }]
  },
  "overrides": [
    {
      "files": ["**/src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(?:^|/)(?:test|scripts|generated)(?:/|$)",
                "message": "Production source must not depend on tests, repository scripts, or generated output."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/src/contracts/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:node:|@agentclientprotocol/)",
                "message": "Public contracts are portable leaves and cannot depend on Node or ACP."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/src/{application,execution}/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(?:^|/)(?:protocols|acp)(?:/|$)|^@agentclientprotocol/",
                "message": "Application and execution use package-private ports, never concrete protocol adapters."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/src/discovery/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(?:^|/)(?:application|manager)(?:/|$)",
                "message": "Discovery does not depend on manager or application."
              }
            ]
          }
        ]
      }
    }
  ]
}
